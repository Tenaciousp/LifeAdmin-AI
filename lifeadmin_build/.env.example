# LifeAdmin AI portable configuration
APP_ENV=development
PORT=8000
# Set a long random value in production. Required when APP_ENV=production.
SESSION_SECRET=
# Public production origin, for example https://lifeadmin.example.com
APP_BASE_URL=

# Persistence
# Leave DATABASE_URL blank to use zero-config SQLite in artifacts/api-server/data/lifeadmin.sqlite3
DATABASE_URL=
SQLITE_DB_PATH=

# Optional AI. Without this, the built-in deterministic guided planner remains functional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Payments. One verified GBP 199 one-time Price; live sales need owner approval.
# false is for authorised private QA only. Set true before paid public launch.
PAID_ACCESS_REQUIRED=false
# Legacy STRIPE_PRICE_LIFEADMIN_COMPLETE is accepted as GBP fallback only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LIFEADMIN_COMPLETE=
STRIPE_PRICE_LIFEADMIN_COMPLETE_GBP=
STRIPE_AUTOMATIC_TAX=false
STRIPE_TERMS_REQUIRED=false

# Comma-separated account emails allowed to open /admin.
ADMIN_EMAILS=

# Development-only test purchase switch. Never enable in production.
DEMO_PAYMENTS=false

# Password recovery remains disabled until delivery and the app origin are approved.
PASSWORD_RECOVERY_ENABLED=false
# Encrypted authenticated SMTP. ssl uses 465; starttls normally uses 587.
# Set the port to match the chosen mode. Never commit credentials.
SMTP_SECURITY=ssl
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
